{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(sbt test)",
      "Bash(sbt compile)",
      "Bash(sbt scalafmtCheckAll)",
      "Bash(scripts/check-local.sh)",
      "Bash(python3 -I scripts/check-skills.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git check-ignore:*)",
      "Bash(scripts/run-local-tests.sh status:*)",
      "Bash(scripts/run-local-tests.sh test:*)",
      "Bash(scripts/run-local-tests.sh analytics:*)",
      "Bash(scripts/run-local-tests.sh interview)",
      "Bash(scripts/run-local-tests.sh retention)",
      "Bash(scripts/run-local-tests.sh recovery)",
      "Bash(scripts/run-local-tests.sh start)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(docker:*)",
      "Bash(sbt run:*)",
      "Bash(scripts/run-local-tests.sh stop:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sbt clean:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.local/config/**)",
      "Read(./.aws/**)",
      "Read(./.codex/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.local/config/**)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git clean:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(git reset --hard:*)",
      "Bash(mongosh:*)",
      "Bash(mongo:*)",
      "Bash(mongodump:*)",
      "Bash(mongorestore:*)",
      "Bash(sudo:*)",
      "Bash(docker compose -f compose.yaml:*)",
      "Bash(docker compose -f compose.cloud.yaml:*)",
      "Bash(docker compose -f compose.atlas-local.yaml:*)",
      "Bash(docker compose up:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker run:*)",
      "Read(./.local/config/test-services/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/scripts/check-skills.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/scripts/guard-harness.py || exit 2"
          }
        ]
      }
    ]
  }
}
