FROM sbtscala/scala-sbt:eclipse-temurin-17.0.20_8_1.13.0_2.13.18

WORKDIR /workspace/analytics

COPY analytics/build.sbt ./
COPY analytics/project ./project
RUN sbt update

COPY analytics/src ./src

ENTRYPOINT ["/bin/sh", "-ec", "[ -n \"$MONGODB_URI\" ] && [ -n \"$ANALYTICS_LAKEHOUSE_ROOT\" ] && [ -n \"$ANALYTICS_TOPIC\" ] && [ -n \"$ANALYTICS_KAFKA_USERNAME\" ] && [ -n \"$ANALYTICS_KAFKA_PASSWORD\" ] && [ -n \"$HIRING_ANALYTICS_HMAC_SECRET_BASE64\" ] || { echo 'required analytics erasure worker configuration is missing' >&2; exit 2; }; exec sbt \"runMain com.example.hiring.analytics.AnalyticsErasureWorkerMain\""]
