{
  "uid": "hiring-backlog",
  "title": "Hiring Backlogs (embedding work, event outbox)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pending items (gaps = unobserved, not zero)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hiring_backlog_pending",
          "legendFormat": "{{hiring_capability}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest pending age",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hiring_backlog_oldest_pending_age_seconds",
          "legendFormat": "{{hiring_capability}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sample age (rising = sampler stale or Mongo unreachable)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hiring_backlog_sample_age_seconds",
          "legendFormat": "{{hiring_capability}}"
        }
      ]
    }
  ]
}
