{
  "uid": "hiring-kafka",
  "title": "Hiring Kafka",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag per partition (gaps = not reported, not zero)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hiring_kafka_consumer_lag",
          "legendFormat": "{{hiring_consumer_group}} {{messaging_destination_name}} p{{messaging_kafka_partition}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Producer send duration p50 / p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(hiring_kafka_producer_send_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hiring_kafka_producer_send_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Producer send failures by error.type (per second)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (rate(hiring_kafka_producer_send_failures_total[1m]))",
          "legendFormat": "{{error_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Partition rebalances by kind (per second)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(hiring_kafka_consumer_rebalances_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
